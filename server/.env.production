NODE_ENV=production
PORT=5000

# PostgreSQL
DATABASE_URL="postgresql://db_user:db_password@db-host:5432/portfolio?schema=public"

# JWT
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=7d

# Frontend URLs
CLIENT_URL=https://public.sarangpatel.tech
PUBLIC_URL=https://public.sarangpatel.tech
CUSTOMER_URL=https://customer.sarangpatel.tech

# Admin defaults / notification email
ADMIN_EMAIL=ops@sarangpatel.tech

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ops@sarangpatel.tech
SMTP_PASS=your-production-app-password
SMTP_FROM="Portfolio V3 <ops@sarangpatel.tech>"

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15551234567

# OpenAI
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Google OAuth
GOOGLE_CLIENT_ID=google-client-id
GOOGLE_CLIENT_SECRET=google-client-secret
GOOGLE_CALLBACK_URL=https://api.sarangpatel.tech/api/customer/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=github-client-id
GITHUB_CLIENT_SECRET=github-client-secret
GITHUB_CALLBACK_URL=https://api.sarangpatel.tech/api/customer/auth/github/callback

# OAuth redirects
OAUTH_SUCCESS_URL=https://customer.sarangpatel.tech/auth/callback
OAUTH_ERROR_URL=https://customer.sarangpatel.tech/login
